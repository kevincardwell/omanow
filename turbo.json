{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "public/core/**",
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    }
  }
}
