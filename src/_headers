/*
  Content-Security-Policy: default-src 'self'; img-src 'self' https://omarchy.org; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
