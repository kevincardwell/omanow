{
  "name": "omaglobe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opt-in, city-level pixel-art globe of Omarchy users",
  "license": "MIT",
  "repository": "github:mark-omarov/omaglobe",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "demo": "wrangler dev --persist-to .wrangler/demo --var DEMO:1 --var PUBLISH_SECONDS:3",
    "deploy": "wrangler deploy",
    "build:land": "node scripts/build-land.mjs",
    "test": "node --test",
    "reset": "node -e \"require('node:fs').rmSync('.wrangler/state', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "wrangler": "4.145.0"
  }
}
