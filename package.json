{
  "name": "omanow-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:mark-omarov/omanow",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "pnpm --filter @omanow/web dev",
    "dev:solo": "pnpm --filter @omanow/web dev:solo",
    "demo": "pnpm --filter @omanow/web demo",
    "reset": "pnpm --filter @omanow/web reset",
    "changeset": "changeset",
    "plugin:install": "pnpm --filter @omanow/plugin install-local",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "turbo": "2.11.5"
  }
}
