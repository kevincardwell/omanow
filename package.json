{
  "name": "omaglobe-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:mark-omarov/omaglobe",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "pnpm --filter @omaglobe/web dev",
    "demo": "pnpm --filter @omaglobe/web demo",
    "reset": "pnpm --filter @omaglobe/web reset",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "plugin:install": "pnpm --filter @omaglobe/plugin install-local"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "turbo": "2.11.5"
  }
}
