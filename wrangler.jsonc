{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omaglobe",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./src",
  },
  "durable_objects": {
    "bindings": [{ "name": "GLOBE", "class_name": "Globe" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Globe"] }],
  "observability": { "enabled": false },
}
